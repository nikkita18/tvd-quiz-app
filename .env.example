# Database Configuration (MySQL / Cloud MySQL such as TiDB, Railway, Aiven, or PlanetScale)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=b12_app
DB_SSL=false

# Flask Secret Key
SECRET_KEY=your-super-secret-key-change-this

# Gmail SMTP Configuration (for sending registration OTPs)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_google_app_password
